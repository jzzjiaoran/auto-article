# =========================================================
# auto-article 环境变量示例
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# 生产部署时同名变量亦可由 GitHub Actions Secrets 注入。
#
# 注意：以下变量为【必填】，缺失时应用启动直接失败：
#   - POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
#   - CREDENTIALS_SECRET（平台账号凭据加密密钥）
#   - LLM_API_KEY（大模型 API Key）
# =========================================================

# ---- 数据库（PostgreSQL，代码库实际使用，非 MySQL）----
POSTGRES_DB=auto_article
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ---- 平台账号凭据加密密钥（必填，缺失启动失败）----
# 请使用强随机值，生产必须通过环境变量/secret manager 注入，切勿提交真实值
CREDENTIALS_SECRET=change-me-32-char-secret-key

# ---- 大模型 ----
# LLM_API_KEY 必填，缺失启动失败；生产必须通过环境变量注入，切勿提交真实值
LLM_API_KEY=sk-your-real-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ---- 热点采集定时任务 ----
APP_CRAWLER_ENABLED=true
APP_CRAWLER_CRON=0 */30 * * * *

# ---- 镜像标签（部署时由 CI 注入 git SHA；本地默认 latest） ----
IMAGE_TAG=latest
