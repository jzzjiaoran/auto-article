# =========================================================
# auto-article 环境变量示例
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# 生产部署时同名变量亦可由 GitHub Actions Secrets 注入。
# =========================================================

# ---- 数据库（PostgreSQL，代码库实际使用，非 MySQL） ----
POSTGRES_DB=auto_article
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ---- 平台账号凭据加密密钥 ----
CREDENTIALS_SECRET=change-me-32-char-secret-key

# ---- 大模型 ----
LLM_API_KEY=sk-your-real-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ---- 热点采集定时任务 ----
APP_CRAWLER_ENABLED=true
APP_CRAWLER_CRON=0 */30 * * * *

# ---- 镜像标签（部署时由 CI 注入 git SHA；本地默认 latest） ----
IMAGE_TAG=latest
